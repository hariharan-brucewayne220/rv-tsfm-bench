# raw data caches (regenerated by python -m src.run --stage download)
data/

# paper PDF (arXiv license does not permit redistribution; see README citation)
paper/

# derivable evaluation artifacts (regenerated by --stage evaluate)
results/losses.parquet
results/losses_crypto.parquet

# run logs and internal agent reports
results/*_log.txt
results/full_run_log*.txt
results/TEST_REPORT.md
results/REVIEW.md

# python
__pycache__/
.pytest_cache/
*.pyc

# validation re-score / re-run outputs: large derivable parquet only
results_rescore/forecasts*.parquet
results_rescore/losses*.parquet
results_rerun/forecasts*.parquet
